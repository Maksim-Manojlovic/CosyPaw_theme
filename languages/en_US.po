msgid "Stigao ti je peškirić? Napiši par reči — to je ono što sledećem kupcu pomogne da izabere."
msgstr "Has your towel arrived? Write a few words — that is what helps the next customer choose."

msgid "Ostavi utisak"
msgstr "Leave a review"

msgid "Izaberi peškirić koji imaš — forma je na njegovoj stranici."
msgstr "Pick the towel you own — the form is on its page."

msgid "Česta pitanja"
msgstr "FAQ"

msgid "Sve što te zanima"
msgstr "Everything you want to know"

msgid "Ako ne nađeš odgovor, piši nam — rado pomažemo."
msgstr "If you don't find an answer, write to us — we're happy to help."

msgid "Od čega su peškirići napravljeni?"
msgstr "What are the towels made of?"

msgid "Od plišane mikrofibre — mekane, lagane i jako upijajuće. Prijatna je i nežnoj dečjoj koži."
msgstr "From plush microfiber — soft, light and highly absorbent. Gentle even on a child's skin."

msgid "Kako se peru?"
msgstr "How are they washed?"

msgid "Mašinsko pranje na 40°C, bez omekšivača da ostanu upijajući. Suše se brzo i ne gube oblik."
msgstr "Machine wash at 40°C, without fabric softener so they stay absorbent. They dry fast and keep their shape."

msgid "Koliko traje dostava?"
msgstr "How long does delivery take?"

msgid "Dostava je 2–4 radna dana na teritoriji cele Srbije. Trio paket stiže uz besplatnu dostavu."
msgstr "Delivery is 2–4 business days across Serbia. The Trio package comes with free shipping."

msgid "Kako mogu da platim?"
msgstr "How can I pay?"

msgid "Plaćanje je pouzećem — platiš kuriru pri preuzimanju paketa."
msgstr "Payment is cash on delivery — you pay the courier when you receive the package."

msgid "Gde mogu da ostavim utisak?"
msgstr "Where can I leave a review?"

msgid "Na dnu početne strane, u delu sa utiscima kupaca, klikni „Ostavi utisak“ i izaberi peškirić koji imaš. Isto možeš i sa stranice svakog peškirića, u tabu „Recenzije“."
msgstr "At the bottom of the home page, in the customer reviews part, click “Leave a review” and pick the towel you own. You can also do it from any towel’s page, in the “Reviews” tab."

msgid "Plaćanje pouzećem"
msgstr "Cash on delivery"

msgid "Plaćaš gotovinom pri preuzimanju — kuriru na vratima ili nama lično."
msgstr "You pay in cash on receipt — to the courier at your door, or to us in person."

msgid "Pripremi iznos u gotovini za trenutak preuzimanja."
msgstr "Have the amount ready in cash for the moment of handover."

msgid "Lično preuzimanje"
msgstr "Local pickup"

msgid "Dostava kurirskom službom (poštarina se plaća kuriru)"
msgstr "Courier delivery (postage paid to the courier)"

