msgid "Paket je pun — ukloni motiv da dodaš drugi"
msgstr "Набор заполнен — удали мотив, чтобы добавить другой"

msgid "Izaberi još %d — paket nije popunjen"
msgstr "Выбери ещё %d — набор не заполнен"

