msgid "U tvom domu"
msgstr "У тебя дома"

msgid "Tvoj kutak, malo mekši"
msgstr "Твой уголок, чуть мягче"

msgid "Pored lavabo, na kuki ili na polici — peškirići se uklope u svaki dom i unesu trunku topline."
msgstr "У раковины, на крючке или на полке — полотенца впишутся в любой дом и добавят капельку тепла."

msgid "Spremni za jutarnju rutinu"
msgstr "Готовы к утренним делам"

msgid "Na kuki, uvek pri ruci"
msgstr "На крючке, всегда под рукой"

msgid "Stiže spremno za poklon"
msgstr "Приходит готовым к подарку"

msgid "Svaki paket je mali poklon"
msgstr "Каждый набор — маленький подарок"

msgid "Pažljivo upakovano u CosyPaw kutiju, sa porukom dobrodošlice i mirisom lavande. Trio paket stiže uz <strong>besplatnu dostavu</strong> — idealno za rođendan, bebi šauer ili samo da nekog razmaziš."
msgstr "Аккуратно упаковано в коробку CosyPaw, с приветственной открыткой и ароматом лаванды. Набор Trio приходит с <strong>бесплатной доставкой</strong> — идеально на день рождения, бэби-шауэр или просто чтобы кого-то побаловать."

msgid "Jezik"
msgstr "Язык"

