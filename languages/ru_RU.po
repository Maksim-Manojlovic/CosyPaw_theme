msgstr "Бесплатная доставка"

msgid "Dodaj u korpu"
msgstr "В корзину"

msgid "Plaćanje pouzećem • Dostava 2–4 radna dana"
msgstr "Оплата при получении • Доставка 2–4 рабочих дня"

msgid "Cela družina"
msgstr "Вся компания"

msgid "Upoznaj sve motive"
msgstr "Познакомься со всеми мотивами"

msgid "Od %s po komadu — ili ih spoji u paket i uštedi."
msgstr "От %s за штуку — или собери в набор и сэкономь."

