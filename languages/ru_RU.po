msgid "Mali zagrljaj pored sudopere"
msgstr "Маленькое объятие у раковины"

msgid "Svaki peškirić je mekan, upijajuć i ima alku za kačenje — uvek pri ruci, uvek sladak."
msgstr "Каждое полотенце мягкое, впитывающее и с петелькой — всегда под рукой, всегда милое."

msgid "Mekano kao oblak"
msgstr "Мягкое, как облако"

msgid "Plišana mikrofibra prijatna i nežnoj dečjoj koži."
msgstr "Плюшевая микрофибра, приятная даже нежной детской коже."

msgid "Upija u trenu"
msgstr "Впитывает мгновенно"

msgid "Brzo suši ručice i ostaje suv i svež tokom dana."
msgstr "Быстро сушит ручки и остаётся сухим и свежим весь день."

msgid "Alka za kačenje"
msgstr "Петелька для подвешивания"

msgid "Okačiš ga na kuku ili ručku — uvek na svom mestu."
msgstr "Повесь на крючок или ручку — всегда на своём месте."

msgid "Savršen poklon"
msgstr "Идеальный подарок"

msgid "Slatka sitnica koja uvek izmami osmeh i „awww”."
msgstr "Милая мелочь, что всегда вызывает улыбку и «ня»."

msgid "Što više grlića, veća ušteda"
msgstr "Чем больше обнимашек, тем больше выгода"

msgid "Izmešaj motive kako želiš — cena po komadu pada sa svakim sledećim."
msgstr "Сочетай мотивы как хочешь — цена за штуку падает с каждым следующим."

