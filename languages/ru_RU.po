msgid "CosyPaw žurnal"
msgstr "Журнал CosyPaw"

msgid "Prethodna"
msgstr "Предыдущая"

msgid "Sledeća"
msgstr "Следующая"

msgid "Ova stranica se sakrila"
msgstr "Эта страница спряталась"

msgid "Stranicu nismo našli — možda je premeštena. Probaj pretragu ili se vrati na početnu."
msgstr "Мы не нашли страницу — возможно, она перемещена. Попробуйте поиск или вернитесь на главную."

msgid "Nazad na početnu"
msgstr "На главную"

msgid "Pretraga"
msgstr "Поиск"

msgid "Pretraži…"
msgstr "Поиск…"

msgid "Traži"
msgstr "Найти"

msgid "Mekani svet peškira"
msgstr "Мягкий мир полотенец"

msgid "Dečiji peškiri od %s"
msgstr "Детские полотенца из %s"

msgid "mikrofibera"
msgstr "микрофибры"

msgid "Izaberi paket"
msgstr "Выбери набор"

msgid "Pogledaj peškire"
msgstr "Смотреть мотивы"

msgid "Ručni rad"
msgstr "Ручная работа"

msgid "Izdvojeni peškiri"
msgstr "Избранные мотивы"

msgid "od %s"
msgstr "от %s"

msgid "Zašto CosyPaw"
msgstr "Почему CosyPaw"

msgid "Mali zagrljaj pored lavaboa"
msgstr "Маленькое объятие у раковины"

msgid "Svaki peškir je mekan, upijajuć i ima alku za kačenje — uvek pri ruci, uvek sladak."
msgstr "Каждое полотенце мягкое, впитывающее и с петелькой — всегда под рукой, всегда милое."

msgid "Deca ih biraju sama"
msgstr "Дети выбирают их сами"

msgid "Ruke se obrišu bez pregovora kad na kuki visi drugar."
msgstr "Руки вытираются без уговоров, когда на крючке висит друг."

msgid "Upija, ne samo ukrašava"
msgstr "Впитывает, а не только украшает"

msgid "Plišana mikrofibra osuši ručice u trenu i ostane sveža do večeri."
msgstr "Плюшевая микрофибра сушит ручки мгновенно и остаётся свежей до вечера."

msgid "Šiven rukom, jedan po jedan"
msgstr "Сшито вручную, по одному"

msgid "Isečen, šiven i pregledan ručno. Nema dva potpuno ista."
msgstr "Раскроено, сшито и проверено вручную. Нет двух совершенно одинаковых."

msgid "Poklon koji se pamti"
msgstr "Подарок, который запоминается"

msgid "Sitnica koja izmami osmeh pre nego što je odmotana."
msgstr "Мелочь, что вызывает улыбку ещё до того, как её развернут."

msgid "Što više peškira, veća ušteda"
msgstr "Чем больше полотенец, тем больше выгода"

msgid "Izmešaj peškire kako želiš — cena po komadu pada sa svakim sledećim."
msgstr "Сочетай мотивы как хочешь — цена за штуку падает с каждым следующим."

msgid "kom"
msgstr "шт"

msgid "Besplatna dostava"
msgstr "Бесплатная доставка"

msgid "Ušteda %s"
msgstr "Экономия %s"

msgid "Dodaj u korpu"
msgstr "В корзину"

msgid "Plaćanje pouzećem • Dostava 2–4 radna dana"
msgstr "Оплата при получении • Доставка 2–4 рабочих дня"

msgid "Cela družina"
msgstr "Вся компания"

msgid "Upoznaj sve peškire"
msgstr "Познакомься со всеми мотивами"

msgid "Dečiji peškiri sa životinjicama, zalogajčićima i cvetićima, od %s po komadu — ili ih spoji u paket i uštedi."
msgstr "Детские полотенца со зверятами, вкусняшками и цветочками, от %s за штуку — или собери в набор и сэкономь."

msgid "%s • 1 kom"
msgstr "%s • 1 шт"

msgid "Korpa"
msgstr "Корзина"

msgid "Kupi"
msgstr "Купить"

msgid "Prikaži sve peškire (%d)"
msgstr "Показать все мотивы (%d)"

msgid "Prikaži manje"
msgstr "Свернуть"

msgid "%1$d+%2$d GRATIS"
msgstr "%1$d+%2$d В ПОДАРОК"

msgid "Dodato u korpu"
msgstr "Добавлено в корзину"

msgid "Dodato"
msgstr "Добавлено"

msgid "Rezultati za „%s”"
msgstr "Результаты по запросу «%s»"

msgid "Mekani svet peškira. Ručno šiveni ljubimci koji čine svako kupatilo toplijim."
msgstr "Мягкий мир полотенец. Сшитые вручную зверушки, что делают любую ванную теплее."

msgid "Brzi linkovi"
msgstr "Быстрые ссылки"

msgid "Paketi"
msgstr "Наборы"

msgid "Svi peškiri"
msgstr "Все мотивы"

msgid "Poručivanje"
msgstr "Заказ"

msgid "Poruči preko DM-a ili korpe.<br>Plaćanje pouzećem."
msgstr "Заказывай через DM или корзину.<br>Оплата при получении."

msgid "© %d CosyPaw — Mekani svet peškira"
msgstr "© %d CosyPaw — Мягкий мир полотенец"

msgid "Ručni rad • Made with love"
msgstr "Ручная работа • Сделано с любовью"

msgid "Zatvori korpu"
msgstr "Закрыть корзину"

msgid "Tvoja korpa"
msgstr "Твоя корзина"

msgid "Zatvori"
msgstr "Закрыть"

msgid "Korpa je još prazna"
msgstr "Корзина пока пуста"

msgid "Izaberi paket ili omiljeni peškir."
msgstr "Выбери набор или любимый мотив."

msgid "Ukupno"
msgstr "Итого"

msgid "Nastavi ka plaćanju"
msgstr "Перейти к оплате"

msgid "Ručni rad sa puno ljubavi"
msgstr "Ручная работа с большой любовью"

msgid "Porudžbine preko %s stižu uz besplatnu dostavu."
msgstr "Заказы свыше %s доставляются бесплатно."

msgid "Besplatna dostava preko %s"
msgstr "Бесплатная доставка от %s"

msgid "Dečiji peškiri od mikrofibera, ručno rađeni, sa alkom za kačenje i preko 20 oblika. Sastavi svoj paket, plaćanje pouzećem, dostava 2–4 dana širom Srbije."
msgstr "Детские полотенца из микрофибры ручной работы, с петелькой, более 20 форм. Собери свой набор, оплата при получении, доставка 2–4 дня по всей Сербии."

msgid "Rezultati pretrage za „%s“."
msgstr "Результаты поиска по запросу «%s»."

msgid "CosyPaw dečiji peškiri od mikrofibera"
msgstr "Детские полотенца CosyPaw из микрофибры"

msgid "Ručno rađeni dečiji peškiri od plišane mikrofibre, sa alkom za kačenje."
msgstr "Детские полотенца ручной работы из плюшевой микрофибры, с петелькой для подвешивания."

msgid "Dečiji peškir od mikrofibera, oblik %s"
msgstr "Детское полотенце из микрофибры, форма «%s»"

msgid "O našim peškirima"
msgstr "О наших полотенцах"

msgid "Ručno rađeni peškiri za decu — i za šape"
msgstr "Полотенца ручной работы для детей — и для лапок"

msgid "Tražiš dečije peškire koji su mekani, upijajući i dovoljno slatki da dete samo poželi da obriše ruke? CosyPaw peškiri od mikrofibera šiju se ručno, jedan po jedan. Plišana mikrofibra je nežna prema dečijoj koži, upija u trenu, brzo se suši i ostaje meka i posle mnogo pranja."
msgstr "Ищешь детские полотенца — мягкие, впитывающие и настолько милые, что ребёнок сам захочет вытереть руки? Полотенца CosyPaw из микрофибры шьются вручную, по одному. Плюшевая микрофибра нежна к детской коже, мгновенно впитывает, быстро сохнет и остаётся мягкой после многих стирок."

msgid "Svaki peškir ima alku za kačenje, pa visi na dečijoj visini — pored lavaboa, na kuki ili na vratima. Kad na kuki čeka drugar, pranje ruku postaje igra, a dete samo bira svoj peškir i samo ga koristi. Izaberi između %1$s: životinjice poput zeke, sove, pande i kapibare, zalogajčići i cvetići."
msgstr "У каждого полотенца есть петелька, поэтому оно висит на высоте ребёнка — у раковины, на крючке или на двери. Когда на крючке ждёт друг, мытьё рук становится игрой, а ребёнок сам выбирает своё полотенце и сам им пользуется. Выбирай из %1$s: зверята — зайчик, сова, панда и капибара, вкусняшки и цветочки."

msgid "%d jedinstvenih oblika"
msgstr "%d уникальных форм"

msgid "CosyPaw peškiri su i %1$s — za rođenje bebe, krštenje, prvi rođendan ili bebi šauer. Svaki paket stiže u CosyPaw kutiji, sa porukom dobrodošlice i mirisom lavande, a ručno rađene peškire šaljemo širom Srbije."
msgstr "Полотенца CosyPaw — это ещё и %1$s: на рождение малыша, крестины, первый день рождения или бэби шауэр. Каждая посылка приходит в коробке CosyPaw, с приветственной запиской и ароматом лаванды, а наши полотенца ручной работы мы отправляем по всей Сербии."

msgid "praktičan i lep poklon"
msgstr "практичный и красивый подарок"

msgid "A kako ime CosyPaw kaže, nisu samo za decu: mnogi ih drže pored vrata kao peškir za pse, za brisanje šapa posle šetnje. Mikrofibra brzo upije vlagu i blato, a peškir se pere u mašini na 40°C."
msgstr "А как подсказывает название CosyPaw, они не только для детей: многие держат их у двери как полотенце для собаки — вытирать лапы после прогулки. Микрофибра быстро впитывает влагу и грязь, а полотенце стирается в машине при 40°C."

msgid "Putanja"
msgstr "Навигационная цепочка"

msgid "Početna"
msgstr "Главная"

msgid "Kolekcija"
msgstr "Коллекция"

msgid "Dečiji peškiri u obliku životinja"
msgstr "Детские полотенца в форме животных"

msgid "%1$d ručno rađenih peškira od mikrofibre, sa alkom za kačenje, od %2$s po komadu. Izaberi drugara za svoje dete — kupi jedan ili ih spoji u paket i uštedi."
msgstr "%1$d полотенец ручной работы из микрофибры, с петелькой, от %2$s за штуку. Выбери друга для своего ребёнка — купи одно или собери набор и сэкономь."

msgid "Peškiri životinjice"
msgstr "Полотенца-зверята"

msgid "Meki drugari koji čekaju na kuki — dete samo bira svog i raduje mu se posle svakog pranja ruku."
msgstr "Мягкие друзья ждут на крючке — ребёнок сам выбирает своего и радуется ему после каждого мытья рук."

msgid "Zalogajčići"
msgstr "Вкусняшки"

msgid "Voće i poslastice od mikrofibre — vesela sitnica za kupatilo ili kuhinju."
msgstr "Фрукты и сладости из микрофибры — весёлая мелочь для ванной или кухни."

msgid "Cvetići i listići"
msgstr "Цветочки и листочки"

msgid "Nežni cvetni oblici za mirniji, prirodni kutak."
msgstr "Нежные цветочные формы для спокойного, природного уголка."

msgid "Peškiri u torbi"
msgstr "Полотенца в сумочке"

msgid "Još peškira"
msgstr "Ещё полотенца"

msgid "Zašto oblici"
msgstr "Зачем формы"

msgid "Dečija higijena kroz igru"
msgstr "Детская гигиена через игру"

msgid "Dečiji peškiri u obliku životinja su mnogo više od običnog tekstila za kupatilo. Kad dete vidi omiljenog drugara kako ga čeka na kuki, baš na njegovoj visini, pranje ruku prestaje da bude obaveza i postaje igra."
msgstr "Детские полотенца в форме животных — это гораздо больше, чем обычный текстиль для ванной. Когда ребёнок видит любимого друга, который ждёт его на крючке прямо на его высоте, мытьё рук перестаёт быть обязанностью и становится игрой."

msgid "Zato je peškir za ruke zeka jedan od najomiljenijih: mekan je, prijateljski i deca ga odmah prepoznaju. Sovica podseća na mirne večernje rutine, a panda i kapibarica unose malo smeha u svako jutro."
msgstr "Поэтому полотенце для рук «зайчик» — одно из самых любимых: мягкое, дружелюбное, и дети сразу его узнают. Совушка напоминает о спокойных вечерних ритуалах, а панда и капибара приносят немного смеха в каждое утро."

msgid "Svi peškiri su od plišane mikrofibre, nežne prema koži, koja se brzo suši i ostaje meka i posle mnogo pranja. Alka za kačenje drži peškir uvek nadohvat ruke, pa dete samo briše ruke i gradi higijenske navike koje ostaju. Svaki je šiven ručno, pa nema dva potpuno ista — baš kao ni dece."
msgstr "Все полотенца из плюшевой микрофибры, нежной к коже, которая быстро сохнет и остаётся мягкой после многих стирок. Петелька держит полотенце всегда под рукой, поэтому ребёнок сам вытирает руки и вырабатывает гигиенические привычки, которые остаются. Каждое сшито вручную, поэтому нет двух совершенно одинаковых — как и детей."

msgid "Kako nastaju naši %s i šta sve stiže u paketu, pročitaj na početnoj strani."
msgstr "Как создаются наши %s и что приходит в посылке — читай на главной странице."

msgid "ručno rađeni peškiri"
msgstr "полотенца ручной работы"

msgid "Tražiš poklon za bebu ili dete? Pogledaj naše %s — spakovane u CosyPaw kutiju, spremne za predaju."
msgstr "Ищешь подарок для малыша или ребёнка? Посмотри наши %s — в коробке CosyPaw, готовые к вручению."

msgid "poklon setove peškira"
msgstr "подарочные наборы полотенец"

msgid "Poklon setovi peškira za decu i bebe"
msgstr "Подарочные наборы полотенец для детей и малышей"

msgid "Pokloni"
msgstr "Подарки"

msgid "Ručno rađeni dečiji peškiri od mikrofibre, složeni u set po tvom izboru i spakovani u CosyPaw kutiju — poklon za bebu i decu koji se otvara uz osmeh i koristi svaki dan."
msgstr "Детские полотенца ручной работы из микрофибры, собранные в набор на твой выбор и упакованные в коробку CosyPaw, — подарок для малышей и детей, который открывают с улыбкой и используют каждый день."

msgid "Poklon za svaku priliku"
msgstr "Подарок для любого случая"

msgid "Za rođenje bebe"
msgstr "На рождение малыша"

msgid "Devojčica ili dečak — mekani drugar za dečiju sobu ili kupatilo, spreman da dočeka bebu."
msgstr "Девочка или мальчик — мягкий друг для детской или ванной, готовый встретить малыша."

msgid "Za krštenje"
msgstr "На крестины"

msgid "Nežan poklon set za bebu koji ostaje u upotrebi i dugo posle slavlja."
msgstr "Нежный подарочный набор для малыша, которым пользуются ещё долго после праздника."

msgid "Za prvi rođendan"
msgstr "На первый день рождения"

msgid "Peškiri koje dete prepoznaje i uz koje uči da samo briše ruke."
msgstr "Полотенца, которые ребёнок узнаёт и с которыми учится сам вытирать руки."

msgid "Za bebi šauer"
msgstr "На бэби шауэр"

msgid "Poklon koji se otvara uz osmeh i koji roditelji zaista koriste svaki dan."
msgstr "Подарок, который открывают с улыбкой и которым родители действительно пользуются каждый день."

msgid "Zašto CosyPaw poklon"
msgstr "Почему подарок CosyPaw"

msgid "Unikatni pokloni za bebu i decu"
msgstr "Уникальные подарки для малышей и детей"

msgid "Pronaći unikatan poklon nije lako, ali poklon set peškira za bebu to rešava jednostavno: praktičan je, lep i pamti se. Svaki set stiže u CosyPaw kutiji, sa porukom dobrodošlice i mirisom lavande, spreman da se preda bez dodatnog pakovanja."
msgstr "Найти уникальный подарок непросто, но подарочный набор полотенец для малыша решает это легко: он практичный, красивый и запоминается. Каждый набор приходит в коробке CosyPaw, с приветственной запиской и ароматом лаванды, готовый к вручению без дополнительной упаковки."

msgid "Bilo da biraš poklon set za bebu za krštenje, poklon za rođenje bebe — devojčica ili dečak — ili poklone za prvi rođendan, roditelji će peškire koristiti svaki dan. Svaki put kad vide drugara na kuki, na dečijoj visini, setiće se tvog gesta. Kao poklon za baby shower naši setovi su posebno omiljeni, jer spajaju lepo i korisno."
msgstr "Выбираешь ли ты подарочный набор на крестины, подарок на рождение малыша — девочки или мальчика — или подарки на первый день рождения, родители будут пользоваться полотенцами каждый день. Каждый раз, видя друга на крючке на высоте ребёнка, они вспомнят о твоём внимании. Как подарок на бэби шауэр наши наборы особенно любимы, потому что сочетают красивое и полезное."

msgid "dečijih peškira u obliku životinja"
msgstr "детских полотенец в форме животных"

msgid "Ako tražiš personalizovane poklone za decu, set sastavljaš sam: izaberi oblike po ukusu deteta iz naše kolekcije %s, zalogajčića i cvetića."
msgstr "Если ищешь персонализированные подарки для детей, набор собираешь сам: выбери формы по вкусу ребёнка из нашей коллекции %s, вкусняшек и цветочков."

msgid "U paketu od %1$d peškira plaćaš %2$d — pokloni za decu ne moraju biti skupi da bi bili nezaboravni."
msgstr "В наборе из %1$d полотенец ты платишь за %2$d — подарки для детей не обязаны быть дорогими, чтобы быть незабываемыми."

msgid "Za porudžbine preko %s dostava je besplatna, a plaćaš pouzećem."
msgstr "Для заказов свыше %s доставка бесплатная, а оплата — при получении."

msgid "Pokloni za bebu širom Srbije stižu za 2–4 radna dana. Više o tome kako nastaju CosyPaw peškiri pročitaj na %s."
msgstr "Подарки для малышей приходят по всей Сербии за 2–4 рабочих дня. Подробнее о том, как создаются полотенца CosyPaw, читай на %s."

msgid "početnoj strani"
msgstr "главной странице"

msgid "Naruči poklon set"
msgstr "Заказать подарочный набор"

msgid "Magična krpica Avokado, limeta"
msgstr "Волшебная салфетка «Авокадо», лайм"

msgid "Magična krpica Avokado, žalfija"
msgstr "Волшебная салфетка «Авокадо», шалфей"

msgid "Magična krpa od mikrofibera u jarkoj limeta zelenoj boji, sa vezenim avokadom. Upija vodu, hvata prašinu i briše staklo bez tragova — za kuhinju, kupatilo i ogledala."
msgstr "Волшебная салфетка из микрофибры ярко-лаймового цвета с вышитым авокадо. Впитывает воду, собирает пыль и вытирает стекло без разводов — для кухни, ванной и зеркал."

msgid "Magična krpa od mikrofibera u nežnoj žalfija zelenoj boji, sa vezenim nasmejanim avokadom. Upija vodu, hvata prašinu i briše staklo bez tragova — za kuhinju, kupatilo i ogledala."
msgstr "Волшебная салфетка из микрофибры нежного шалфейно-зелёного цвета с вышитым улыбающимся авокадо. Впитывает воду, собирает пыль и вытирает стекло без разводов — для кухни, ванной и зеркал."

msgid "Rebrasta mikrofibra upija vodu i hvata prašinu umesto da je razmazuje, pa je ista krpa jednako dobra kao kuhinjska krpa za radne površine i sudove i kao krpa za staklo, ogledala i tuš kabine. Briše bez tragova i dlačica, bez agresivnih sredstava. Višekratna je i pere se u mašini na 40°C, bez omekšivača, da zadrži upijanje — i zamenjuje gomilu papirnih ubrusa."
msgstr "Рельефная микрофибра впитывает воду и собирает пыль, а не размазывает её, поэтому одна и та же салфетка одинаково хороша и как кухонная — для столешниц и посуды, — и как салфетка для стекла, зеркал и душевых кабин. Вытирает без разводов и ворса, без агрессивных средств. Многоразовая, стирается в машине при 40°C без кондиционера, чтобы сохранить впитываемость, — и заменяет гору бумажных полотенец."

msgid "Namena"
msgstr "Назначение"

msgid "Rebrasta mikrofibra — upija vodu i hvata prašinu."
msgstr "Рельефная микрофибра — впитывает воду и собирает пыль."

msgid "Kuhinja, staklo, ogledala, tuš kabine i radne površine."
msgstr "Кухня, стекло, зеркала, душевые кабины и столешницы."

msgid "Mašinsko pranje na 40°C, bez omekšivača."
msgstr "Машинная стирка при 40°C, без кондиционера."

msgid "Dodaj %s u korpu"
msgstr "Добавить «%s» в корзину"

msgid "Novo"
msgstr "Новинка"

msgid "Magične krpice"
msgstr "Волшебные салфетки"

msgid "Mikrofiber krpice sa vezenim avokadom — upijaju vodu, hvataju prašinu i brišu staklo bez tragova. %s po komadu, van paketa peškira."
msgstr "Салфетки из микрофибры с вышитым авокадо — впитывают воду, собирают пыль и вытирают стекло без разводов. %s за штуку, вне наборов полотенец."

msgid "Sve o magičnim krpama"
msgstr "Всё о волшебных салфетках"

msgid "Set od 2 magične krpice Avokado"
msgstr "Набор из 2 волшебных салфеток «Авокадо»"

msgid "Obe magične krpice Avokado u jednom setu — limeta i žalfija zelena. Upijaju vodu, hvataju prašinu i brišu staklo bez tragova: jedna za kuhinju, druga za staklo i ogledala."
msgstr "Обе волшебные салфетки «Авокадо» в одном наборе — лайм и шалфейно-зелёная. Впитывают воду, собирают пыль и вытирают стекло без разводов: одна для кухни, другая для стекла и зеркал."

msgid "U setu"
msgstr "В наборе"

msgid "2 krpice: limeta i žalfija zelena."
msgstr "2 салфетки: лайм и шалфейно-зелёная."

msgid "Uštedi %s"
msgstr "Экономия %s"

msgid "Pojedinačno:"
msgstr "По отдельности:"

msgid "Dodaj set u korpu"
msgstr "Добавить набор в корзину"

msgid "Magične krpe"
msgstr "Волшебные салфетки"

msgid "Magična krpa za savršeno čist dom"
msgstr "Волшебная салфетка для идеально чистого дома"

msgid "Mikrofiber krpa sa vezenim avokadom koja upija vodu, hvata prašinu i briše staklo bez tragova. Kuhinjska krpa i krpa za staklo u jednoj, za %s."
msgstr "Салфетка из микрофибры с вышитым авокадо, которая впитывает воду, собирает пыль и вытирает стекло без разводов. Кухонная салфетка и салфетка для стекла в одной — за %s."

msgid "Čišćenje bez tragova"
msgstr "Уборка без разводов"

msgid "Kuhinjske krpe i krpe za staklo u jednoj"
msgstr "Кухонные салфетки и салфетки для стекла в одной"

msgid "Želiš li da čišćenje bude brže, lakše i potpuno bez tragova? Magična krpa je upravo to. Ova mikrofiber krpa spaja mekoću, izdržljivost i praktičnost: kao kuhinjska krpa upija vodu sa radnih površina i sudova, a kao krpa za prašinu zadržava čestice umesto da ih razbacuje po vazduhu."
msgstr "Хотелось ли тебе, чтобы уборка была быстрее, проще и совсем без разводов? Волшебная салфетка — именно это. Эта салфетка из микрофибры сочетает мягкость, прочность и практичность: как кухонная она впитывает воду со столешниц и посуды, а как салфетка для пыли удерживает частицы, а не разбрасывает их в воздух."

msgid "Posebno je dobra na staklu. Magične krpe za stakla ostavljaju blistav sjaj bez mrlja, tragova i dlačica, bez agresivnih hemijskih sredstava. Nisu samo za prozore: ista krpa za staklo briše ogledala u kupatilu, staklene vitrine, tuš kabine, pa i ekran televizora."
msgstr "Особенно хороша на стекле. Волшебные салфетки для стекла оставляют яркий блеск без пятен, разводов и ворса, без агрессивной химии. Они не только для окон: та же салфетка для стекла протирает зеркала в ванной, стеклянные витрины, душевые кабины и даже экран телевизора."

msgid "Ako tražiš najbolju krpu za staklo, onu kakvu očekuješ od profesionalnih krpa za stakla, a da ostane i u kuhinji, ovo je ta. Krpe su višekratne, peru se u mašini na 40°C i zamenjuju gomilu papirnih ubrusa."
msgstr "Если ищешь лучшую салфетку для стекла — такую, какой ждёшь от профессиональных салфеток для стёкол, и чтобы она пригодилась и на кухне, — это она. Салфетки многоразовые, стираются в машине при 40°C и заменяют гору бумажных полотенец."

msgid "Magične krpice šaljemo kao i %s peškire — u CosyPaw paketu, uz plaćanje pouzećem i dostavu 2–4 dana širom Srbije."
msgstr "Волшебные салфетки мы отправляем так же, как полотенца %s, — в посылке CosyPaw, с оплатой при получении и доставкой по всей Сербии за 2–4 дня."

msgid "Dodaj ih uz paket peškira i lakše stigni do besplatne dostave preko %s."
msgstr "Добавь их к набору полотенец — и легче дойдёшь до бесплатной доставки от %s."

msgid "Poruči magične krpe"
msgstr "Заказать волшебные салфетки"

